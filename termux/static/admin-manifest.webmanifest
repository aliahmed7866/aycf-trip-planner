{
  "name": "Phone Admin Hub",
  "short_name": "Admin Hub",
  "description": "Local control centre for Termux applications.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#070b14",
  "theme_color": "#070b14",
  "icons": [
    {
      "src": "/static/admin-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/static/admin-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}