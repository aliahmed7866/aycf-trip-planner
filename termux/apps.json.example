{
  "apps": [
    {
      "id": "aycf",
      "name": "AYCF Trip Planner",
      "icon": "✈️",
      "accent": "blue",
      "description": "Flight scanner, stability intelligence and itinerary planning",
      "service": "aycf",
      "port": 8080,
      "health_url": "http://127.0.0.1:8080/health",
      "open_url": "http://127.0.0.1:8080"
    },
    {
      "id": "sunscape",
      "name": "Sunscape",
      "icon": "🌅",
      "accent": "amber",
      "description": "Sunrise, sunset and golden-hour planning",
      "service": "sunscape",
      "port": 8081,
      "health_url": "http://127.0.0.1:8081/health",
      "open_url": "http://127.0.0.1:8081"
    },
    {
      "id": "expenses",
      "name": "Pocketwise",
      "icon": "💷",
      "accent": "green",
      "description": "Expenses, income, budgets and debt payoff",
      "service": "expense-manager",
      "install_command": [
        "bash",
        "$APP_ROOT/termux/install-expense-manager.sh"
      ],
      "port": 8082,
      "health_url": "http://127.0.0.1:8082/health",
      "open_url": "http://127.0.0.1:8082"
    },
    {
      "id": "mediahub",
      "name": "Media Hub",
      "icon": "🎬",
      "accent": "violet",
      "description": "Save supported video and audio for offline use",
      "service": "mediahub",
      "install_command": [
        "bash",
        "$APP_ROOT/termux/install-mediahub.sh"
      ],
      "port": 8083,
      "health_url": "http://127.0.0.1:8083/health",
      "open_url": "http://127.0.0.1:8083"
    },
    {
      "id": "places",
      "name": "Places",
      "icon": "🌍",
      "accent": "earth",
      "description": "Personal travel journal, atlas and year-in-travel calendar",
      "manager": "command",
      "status_command": ["$HOME/.local/bin/places", "status"],
      "start_command": ["$HOME/.local/bin/places", "start"],
      "stop_command": ["$HOME/.local/bin/places", "stop"],
      "restart_command": ["$HOME/.local/bin/places", "restart"],
      "install_command": [
        "bash",
        "$APP_ROOT/termux/install-places.sh"
      ],
      "port": 8084,
      "health_url": "http://127.0.0.1:8084/health",
      "open_url": "http://127.0.0.1:8084"
    }
  ]
}
